// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for tracking user preferences and progress
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  language  String   @default("ar") // 'en' or 'ar'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User preferences
  preferences UserPreferences?

  @@map("users")
}

// User preferences for analytics and settings
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Analytics consent
  analyticsEnabled Boolean @default(false)
  cookieConsent    String? // 'accepted', 'declined', or null

  // Language preferences
  preferredLanguage String @default("ar")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// Analytics events for tracking user behavior
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  eventType String // 'page_view', 'article_view', 'language_change', etc.
  eventData Json? // Additional event data
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("analytics_events")
}

// Historical figures model
model Person {
  id                 String  @id @default(cuid())
  name               String
  fullName           String?
  /// The teknonym a person is addressed by, e.g. أبو محمد. A name, not a title:
  /// see docs/adr/0014-a-kunya-is-a-name.md.
  kunya              String?
  nameTransliterated String? // Transliterated name for search/display

  // MALE or FEMALE. A string rather than an enum, matching Battle.engagement,
  // so the vocabulary lives in src/lib/catalog/types.ts where validateCatalog
  // can enforce it. It is what lets an ambiguous reciprocal be resolved without
  // the author stating it -- see src/lib/catalog/relations.ts.
  sex                        String?
  birthYearHijri             String? // e.g., "53 BH", "1 AH" (store as string for flexibility)
  birthYearGregorian         String? // e.g., "570 CE", "622 CE"
  deathYearHijri             String?
  deathYearGregorian         String?
  placeOfBirthArabic         String?
  placeOfBirthTransliterated String?
  placeOfDeathArabic         String?
  placeOfDeathTransliterated String?

  picture    String? // will contain some illustraion of the name probably
  appearance String? // description of the appearance
  virtues    String? // description of the virtues should be fetched from a book
  slug       String  @unique // Unique slug for person's page

  graphRank           Int? // 1 = most prominent over the unified Person+Battle+Title+Event graph; null = not yet computed
  clusterId           Int? // Louvain community id from the unified graph, for zoom-out cluster collapse
  layoutX             Float? // precomputed x position from the unified graph layout
  layoutY             Float? // precomputed y position from the unified graph layout
  graphRankComputedAt DateTime? // when graphRank/clusterId/layoutX/layoutY were last (re)computed by scripts/graph/computeGraphLayout.ts

  titles         Title[]               @relation("PersonTitles")
  participations BattleParticipation[]
  events         Event[]
  ayat           Ayah[]                @relation("PersonAyahs")
  said           Utterance[]           @relation("UtteranceSpeaker")
  spokenAbout    Utterance[]           @relation("UtteranceSubject")

  @@map("persons")
}

/// A historical work in one specific consulted edition. Bibliographic details
/// that differ (editor, publisher, year) belong to separate rows, because a
/// source account's identity includes its edition — see
/// docs/data-quality-references.md.
model HistoricalSource {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  author          String?
  editor          String?
  publisher       String?
  publicationYear String?
  edition         String?
  /// The website the edition was read on, such as Shamela or Islamweb. Kept
  /// apart from the work itself: a host is not a publisher.
  digitalHost     String?
  url             String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts  SourceAccount[]
  citations Citation[]

  @@map("historical_sources")
}

/// How strongly the editorial team considers a claim supported. This describes
/// the claim, not the historical figure or source as a whole.
enum ClaimConfidence {
  ESTABLISHED
  LIKELY
  DISPUTED
  UNASSESSED
}

/// Progress of editorial checking, shown to readers rather than used to hide
/// data: recorded information is public at any status, and importing a batch
/// stays a separate approval — see docs/adr/0008-separate-review-from-visibility.md.
enum ClaimReviewStatus {
  NOT_REVIEWED
  IN_REVIEW
  REVIEWED
}

/// The historical subject types evidence can be attached to. Subjects are
/// addressed by kind and slug so graph-only people and other subjects without
/// a profile row can carry citations — see
/// docs/adr/0009-citations-independent-of-profiles.md.
enum SubjectKind {
  PERSON
  TITLE
  BATTLE
  EVENT
}

/// Whether a passage belongs to the historical author's text or to the
/// edition's editorial apparatus. The two stay attributable to different
/// authors even on the same printed page.
enum PassageKind {
  BODY
  NOTE
}

/// A group of proposed historical records submitted together for the user's
/// approval. Approval is recorded against `revision`, so edits after approval
/// need reapproval.
model ReviewBatch {
  id          String    @id @default(cuid())
  /// A batch is identified by slug and revision together: the same batch is
  /// approved and imported again whenever its files change.
  slug        String
  revision    String
  summaryPath String
  approvedAt  DateTime?
  approvedBy  String?
  importedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  claims   HistoricalClaim[]
  accounts SourceAccount[]

  @@unique([slug, revision])
  @@map("review_batches")
}

/// An attributed assertion about a historical subject, or about a directed
/// relationship between two subjects when the related fields are set.
/// Relationship identity mirrors Neo4j: subject slug, type, related slug.
model HistoricalClaim {
  id                 String            @id @default(cuid())
  /// The claim's key in its authoring file. Files are the source of truth, so
  /// re-importing a batch updates the same row instead of duplicating it.
  authoringKey       String            @unique
  subjectKind        SubjectKind
  subjectSlug        String
  /// The profile field this claim speaks to, such as `fullName`. Null for a
  /// biographical statement that maps to no single field.
  field              String?
  assertion          String            @db.Text
  relationshipType   String?
  relatedSubjectKind SubjectKind?
  relatedSubjectSlug String?
  confidence         ClaimConfidence   @default(UNASSESSED)
  reviewStatus       ClaimReviewStatus @default(NOT_REVIEWED)
  reviewerNote       String?           @db.Text
  reviewedAt         DateTime?
  /// Set when accounts conflict. Independent of review status: a fully
  /// reviewed claim can still be disputed.
  disputed           Boolean           @default(false)
  batchId            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  batch     ReviewBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  citations Citation[]

  @@index([subjectKind, subjectSlug])
  @@index([subjectSlug, relationshipType, relatedSubjectSlug])
  @@map("historical_claims")
}

/// The complete entry about one subject in one work and edition, stored page by
/// page so profiles can page through it as printed.
model SourceAccount {
  id              String      @id @default(cuid())
  sourceId        String
  subjectKind     SubjectKind
  subjectSlug     String
  /// The work's own entry or section number, when it numbers entries.
  entryIdentifier String?
  titleArabic     String?
  volume          String?
  extractionUrl   String
  accessedAt      DateTime
  batchId         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  source    HistoricalSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  batch     ReviewBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  pages     SourceAccountPage[]
  citations Citation[]

  @@unique([sourceId, subjectKind, subjectSlug])
  @@index([subjectKind, subjectSlug])
  @@map("source_accounts")
}

/// One printed page of an account. `printedPage` is the page as printed and
/// `sequence` is its position within this account, because an account can begin
/// mid-page and printed numbering is not always contiguous.
model SourceAccountPage {
  id            String  @id @default(cuid())
  accountId     String
  sequence      Int
  printedPage   String?
  bodyMarkdown  String  @db.Text
  notesMarkdown String? @db.Text
  extractionUrl String?

  account  SourceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passages SourcePassage[]

  @@unique([accountId, sequence])
  @@index([accountId, printedPage])
  @@map("source_account_pages")
}

/// A citable span within a page. `anchor` is authored in the data files and
/// stays stable across re-extraction, so citation links keep landing on the
/// cited text.
model SourcePassage {
  id      String      @id @default(cuid())
  pageId  String
  anchor  String
  kind    PassageKind @default(BODY)
  excerpt String      @db.Text

  page      SourceAccountPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@unique([pageId, anchor])
  @@map("source_passages")
}

/// A pinpoint reference from a claim or a biography paragraph to the exact place
/// in a source it came from. A claim may carry several; a citation with no claim
/// supports the paragraph named by `paragraphKey`, or the subject's reference
/// list alone.
model Citation {
  id             String      @id @default(cuid())
  claimId        String?
  subjectKind    SubjectKind
  subjectSlug    String
  sourceId       String
  accountId      String?
  passageId      String?
  paragraphKey   String?
  footnoteNumber Int?
  volume         String?
  /// The page as printed. Absent when the digital source provides none.
  pageReference  String?
  /// The exact page the passage was read from. Required: a citation without a
  /// working link cannot be rechecked.
  extractionUrl  String
  excerptArabic  String      @db.Text
  accessedAt     DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  claim   HistoricalClaim? @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source  HistoricalSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  account SourceAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  passage SourcePassage?   @relation(fields: [passageId], references: [id], onDelete: SetNull)

  @@index([subjectKind, subjectSlug])
  @@index([claimId])
  @@map("citations")
}

model Title {
  id                 String   @id @default(cuid())
  name               String
  nameTransliterated String?
  desc               String?
  slug               String   @unique
  people             Person[] @relation("PersonTitles")

  graphRank           Int? // 1 = most prominent over the unified Person+Battle+Title+Event graph; null = not yet computed
  clusterId           Int? // Louvain community id from the unified graph, for zoom-out cluster collapse
  layoutX             Float? // precomputed x position from the unified graph layout
  layoutY             Float? // precomputed y position from the unified graph layout
  graphRankComputedAt DateTime? // when graphRank/clusterId/layoutX/layoutY were last (re)computed by scripts/graph/computeGraphLayout.ts
}

model Battle {
  id                 String  @id @default(cuid())
  name               String
  slug               String  @unique
  description        String?
  location           String?
  locationEn         String?
  hijriYear          Int?
  hijriPeriod        String?
  gregorianYear      Int?
  gregorianPeriod    String?
  nameTransliterated String?

  // GHAZWAH, SARIYYAH or BATTLE. A string rather than an enum so a new kind of
  // engagement does not need a migration; the vocabulary that constrains it
  // lives in src/lib/catalog/types.ts and validateCatalog enforces it.
  // See README, "What is implemented".
  engagement String?

  // How many each side put in the field, and how many of each side died. Four
  // separate columns because the sources count the two sides separately and
  // often disagree; the catalog takes one figure per column and the competing
  // ones stay as DISPUTED claims. See README, "What is implemented".
  muslimForceCount    Int?
  nonMuslimForceCount Int?
  muslimDeathCount    Int?
  nonMuslimDeathCount Int?

  // New fields for Google Maps coordinates
  latitude  Float? // Latitude coordinate (e.g., 27.6099)
  longitude Float? // Longitude coordinate (e.g., 35.7501)

  // Relations
  participations BattleParticipation[]
  utterances     Utterance[]

  graphRank           Int? // 1 = most prominent over the unified Person+Battle+Title+Event graph; null = not yet computed
  clusterId           Int? // Louvain community id from the unified graph, for zoom-out cluster collapse
  layoutX             Float? // precomputed x position from the unified graph layout
  layoutY             Float? // precomputed y position from the unified graph layout
  graphRankComputedAt DateTime? // when graphRank/clusterId/layoutX/layoutY were last (re)computed by scripts/graph/computeGraphLayout.ts

  createdAt DateTime @default(now()) // Add createdAt and updatedAt for better tracking
  updatedAt DateTime @updatedAt

  @@map("battles")
}

enum ParticipationStatus {
  DIED
  INJURED
  CAPTURED
  WAS_CAPTURED
  ABSENT_EXCUSED
  MARTYRED
}

/// Whether the person was at the battle. What happened to them there is
/// status's job, and each relation admits its own statuses -- see
/// docs/adr/0013-separate-attendance-from-outcome.md.
enum ParticipationRelation {
  PARTICIPATED_IN
  ABSENT_FROM
}

model BattleParticipation {
  id       String @id @default(cuid())
  person   Person @relation(fields: [personId], references: [id])
  personId String
  battle   Battle @relation(fields: [battleId], references: [id])
  battleId String

  isMuslim Boolean
  relation ParticipationRelation @default(PARTICIPATED_IN)
  status   ParticipationStatus[]

  /// What the person did at the battle, in the source's own wording.
  summary String?

  createdAt DateTime @default(now()) // Add createdAt and updatedAt for better tracking
  updatedAt DateTime @updatedAt

  @@unique([personId, battleId])
}

model Event {
  id                        String    @id @default(cuid())
  name                      String
  nameTransliterated        String?
  slug                      String    @unique
  type                      EventType
  hijriYear                 Int?
  hijriPeriod               String?
  gregorianYear             Int?
  gregorianPeriod           String?
  location                  String?
  locationTransliterated    String?
  description               String?   @db.Text
  descriptionTransliterated String?   @db.Text
  metadata                  Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Relations
  people     Person[]
  utterances Utterance[]

  graphRank           Int? // 1 = most prominent over the unified Person+Battle+Title+Event graph; null = not yet computed
  clusterId           Int? // Louvain community id from the unified graph, for zoom-out cluster collapse
  layoutX             Float? // precomputed x position from the unified graph layout
  layoutY             Float? // precomputed y position from the unified graph layout
  graphRankComputedAt DateTime? // when graphRank/clusterId/layoutX/layoutY were last (re)computed by scripts/graph/computeGraphLayout.ts

  @@map("events") // Map to 'events' table
}

/// Something someone said, in verse or in prose, kept as its own record rather
/// than folded into a profile field. See
/// docs/adr/0015-one-record-for-what-someone-said.md.
model Utterance {
  id   String @id @default(cuid())
  slug String @unique

  /// POETRY or SAYING. A string rather than an enum, matching Battle.engagement
  /// and Person.sex, so the vocabulary lives in src/lib/catalog/types.ts where
  /// validateCatalog can enforce it.
  kind String

  /// The words themselves, as the source prints them. Verse keeps its line
  /// breaks; a hemistich separator is the source's own.
  textArabic String @db.Text

  /// Whose words these are. speakerName carries a poet the app has no subject
  /// for, which is the common case in the sira's verse: naming him here does
  /// not make him a node.
  speaker     Person? @relation("UtteranceSpeaker", fields: [speakerId], references: [id])
  speakerId   String?
  speakerName String?

  /// Who the words are about, where the source says so and the app has them.
  subject   Person? @relation("UtteranceSubject", fields: [subjectId], references: [id])
  subjectId String?

  /// Where it was said, when the source ties it to one of these.
  event    Event?  @relation(fields: [eventId], references: [id])
  eventId  String?
  battle   Battle? @relation(fields: [battleId], references: [id])
  battleId String?

  /// What the source says about how sound the report is, in the source's own
  /// words: أخرجه البخاري, إسناده حسن, حديث منكر. The app grades nothing.
  grading String?

  /// What the source says the occasion was, in its own wording.
  occasion String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("utterances")
}

enum EventType {
  BIRTH
  DEATH
  MARRIAGE
  GAVE_BIRTH
  LIBERATED
  MET
  TRAVEL
  HIJRA
  HIJRA_HABASHA
  OTHER
}

enum RevelationType {
  Meccan
  Medinan
}

enum RecitationType {
  HAFS
  WARSH
}

model Surah {
  id                 String          @id @default(cuid())
  name               String
  number             Int
  nameTransliterated String?
  nameTranslated     String?
  numberOfAyat       Int
  revelationType     RevelationType?
  revelationPeriod   String?
  revelationOrder    Int?
  recitation         RecitationType?
  page               Int?

  ayat Ayah[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("surahs")
}

model Ayah {
  id      String @id @default(cuid())
  surahId String

  number           Int
  globalNumber     Int?
  recitation       RecitationType?
  text             String
  juz              Int
  manzil           Int
  page             Int
  ruku             Int
  hizbQuarter      Int
  sajda            Boolean
  revelationOrder  Int?
  revelationPeriod String?
  revelationType   RevelationType?
  sajdaRecommended Boolean?
  sajdaObligatory  Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  surah  Surah    @relation(fields: [surahId], references: [id], onDelete: Cascade)
  people Person[] @relation("PersonAyahs")

  @@map("ayahs")
}
