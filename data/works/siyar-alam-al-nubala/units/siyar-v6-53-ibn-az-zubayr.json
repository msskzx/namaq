    {
      "id": "sp_iz44",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "365",
      "layer": "MAIN",
      "exact": "فَجَاءَ عَبْدُ اللهِ بَعْدَ سَبْعِ سِنِيْنَ لِيُبَايِعَ النَّبِيَّ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - أَمَرَهُ بِذَلِكَ أَبُوْهُ الزُّبَيْرُ، فَتَبَسَّمَ النَّبِيُّ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - حِيْنَ رَآهُ مُقْبِلاً، ثُمَّ بَايَعَهُ."
    },
    {
      "id": "sp_iz51",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "365",
      "layer": "MAIN",
      "exact": "وَفِي البُخَارِيِّ، عَنْ عُرْوَةَ"
    },
    {
