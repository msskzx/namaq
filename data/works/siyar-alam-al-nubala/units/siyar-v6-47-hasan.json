      "id": "sp_hs22",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "248",
      "layer": "MAIN",
      "exact": "ابْنُ عُيَيْنَةَ: عَنْ عَمْرٍو، عَنْ عِكْرِمَةَ، قَالَ:"
    },
    {
      "id": "sp_hs25",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "248",
      "layer": "MAIN",
      "exact": "لَمَّا وَلدَتْ فَاطِمَةُ حَسَناً، أَتَتِ النَّبِيَّ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - فَسَمَّاهُ: حَسَناً. فَلَمَّا وَلَدَتِ الآخرَ، سَمَّاهُ: حُسَيْناً"
    },
    {
      "id": "sp_hs29",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "248",
      "layer": "MAIN",
      "exact": "لَمَّا وَلدَتْ فَاطِمَةُ حَسَناً، قَالَتْ: يَا رَسُوْلَ اللهِ! أَلاَ أَعُقُّ عَنِ ابْنِي"
    },
    {
      "id": "sp_hs32",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "248",
      "layer": "MAIN",
      "exact": "فَلَمَّا وَلَدَتِ الآخرَ، سَمَّاهُ: حُسَيْناً"
    },
    {
      "id": "sp_hs38",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "246",
      "layer": "MAIN",
      "exact": "قَالَهُ: أَبُو جُحَيْفَةَ"
    },
    {
