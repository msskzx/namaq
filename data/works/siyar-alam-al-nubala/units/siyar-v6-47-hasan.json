      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "246",
      "layer": "MAIN",
      "exact": "وَكَانَ يُشْبِهُ جَدَّهُ رَسُوْلَ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ -."
    },
    {
      "id": "sp_hs42",
