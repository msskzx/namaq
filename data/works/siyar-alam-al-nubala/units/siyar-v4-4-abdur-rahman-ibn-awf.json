      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "75",
      "layer": "MAIN",
      "exact": "عَنْ حَسَنِ بنِ عُمَرَ، عَنْ سَهْلَةَ بِنْتِ عَاصِمٍ قَالَتْ:"
    },
    {
      "id": "sp_aw_app1",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "75",
      "layer": "MAIN",
      "exact": "كَانَ عَبْدُ الرَّحْمَنِ بنُ عَوْفٍ أَبْيَضَ، أَعْيَنَ، أَهَدَبَ الأَشْفَارِ، أَقْنَى، طَوِيْلَ النَّابَيْنِ الأَعْلَيَيْنِ، رُبَّمَا أَدْمَى نَابُهُ شَفَتَهُ، لَهُ جُمَّةٌ أَسْفَلَ مِنْ أُذُنَيْهِ، أَعْنَقَ، ضَخْمَ الكَتِفَيْنِ"
    },
    {
      "id": "sp_aw_app2_frame",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "75",
      "layer": "MAIN",
      "exact": "وَرَوَى: زِيَادٌ البَكَّائِيُّ، عَنِ ابْنِ إِسْحَاقَ، قَالَ:"
    },
    {
      "id": "sp_aw_app2",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "75",
      "layer": "MAIN",
      "exact": "كَانَ سَاقِطَ الثَّنِيَّتَيْنِ، أَهْتَمَ، أَعْسَرَ، أَعْرَجَ، كَانَ أُصِيْبَ يَوْمَ أُحُدٍ فُهُتِمَ، وَجُرِحَ عِشْرِيْنَ جِرَاحَةً، بَعْضُهَا فِي رِجْلِهِ فَعَرَجَ"
    },
    {
      "id": "sp_aw_uhud_day",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "75",
      "layer": "MAIN",
      "exact": "يَوْمَ أُحُدٍ",
      "prefix": "كَانَ أُصِيْبَ "
    },
    {
      "id": "sp_aw_app3_isnad",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "75",
      "layer": "MAIN",
      "exact": "عَنْ يَعْقُوْبَ بنِ عُتْبَةَ، قَالَ:"
    },
    {
      "id": "sp_aw_app3",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "75",
      "layer": "MAIN",
      "exact": "وَكَانَ عَبْدُ الرَّحْمَنِ رَجُلاً طُوَالاً، حَسَنَ الوَجْهِ، رَقِيْقَ البَشْرَةِ، فِيْهِ جَنَأٌ أَبْيَضَ، مُشْرَباً حُمْرَةً، لاَ يُغَيِّرُ شَيْبَهُ"
    },
    {
      "id": "sp_aw_manaqib",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 4,
      "page": "78",
      "layer": "MAIN",
      "exact": "وَمِنْ مَنَاقِبِهِ: أَنَّ النَّبِيَّ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ- شَهِدَ لَهُ بِالجَنَّةِ، وَأَنَّهُ مِنْ أَهْلِ بَدْرٍ الَّذِيْنَ قِيْلَ لَهُم: (اعْمَلُوا مَا شِئْتُم (١))"
    },
    {
