    {
      "id": "v1",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "381",
      "layer": "MAIN",
      "exact": "اللَّهُمَّ اغْفِرْ لِعَبْدِ اللهِ بنِ قَيْسٍ ذَنْبَهُ، وَأَدْخِلْهُ يَوْمَ القِيَامَةِ مُدْخَلاً كَرِيْماً"
    },
    {
      "id": "v2f",
