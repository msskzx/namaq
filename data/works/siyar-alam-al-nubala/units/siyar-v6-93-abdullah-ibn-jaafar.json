      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "456",
      "layer": "MAIN",
      "exact": "وَكَانَ كَبِيْرَ الشَّأْنِ، كَرِيْماً، جَوَاداً، يَصْلُحُ لِلإِمَامَةِ"
    },
    {
      "id": "sp_aj_irdaf_isnad",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "457",
      "layer": "MAIN",
      "exact": "مَهْدِيُّ بنُ مَيْمُوْنٍ: حَدَّثَنَا مُحَمَّدُ بنُ عَبْدِ اللهِ بنِ أَبِي يَعْقُوْبَ، عَنِ الحَسَنِ بنِ سَعْدٍ، عَنْ عَبْدِ اللهِ بنِ جَعْفَرٍ"
    },
    {
      "id": "sp_aj_irdaf",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "457",
      "layer": "MAIN",
      "exact": "أَرْدَفَنِي رَسُوْلُ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ خَلْفَهُ، فَأَسَرَّ إِلَيَّ حَدِيثاً لاَ أُحَدِّثُ بِهِ أَحَداً"
    },
    {
