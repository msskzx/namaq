      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "457",
      "layer": "MAIN",
      "exact": "مُحَمَّدُ بنُ عَبْدِ اللهِ بنِ أَبِي يَعْقُوْبَ: عَنِ الحَسَنِ بنِ سَعْدٍ، عَنْ عَبْدِ اللهِ"
    },
