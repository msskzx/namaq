      "page": "331",
      "layer": "MAIN",
      "exact": "أَبُو العَبَّاسِ",
      "prefix": "وَإِمَامُ التَّفْسِيْرِ،"
    },
    {
      "id": "sp_ib10",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "331",
      "layer": "MAIN",
      "exact": "حَبْرُ الأُمَّةِ",
