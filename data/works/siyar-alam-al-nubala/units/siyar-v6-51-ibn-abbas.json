      "volume": 6,
      "page": "332",
      "layer": "MAIN",
      "exact": "عَمِّ رَسُوْلِ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - العَبَّاسِ بنِ عَبْدِ المُطَّلِبِ شَيْبَةَ بنِ هَاشِمٍ"
    },
    {
      "id": "sp_ib14",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "332",
      "layer": "MAIN",
      "exact": "العَبَّاسِ بنِ عَبْدِ المُطَّلِبِ شَيْبَةَ",
      "prefix": "عَمِّ رَسُوْلِ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ -"
    },
    {
      "id": "sp_ib20",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "332",
      "layer": "MAIN",
      "exact": "صَحِبَ النَّبِيَّ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - نَحْواً مِنْ ثَلاَثينَ شَهْراً"
    },
    {
      "id": "sp_ib24",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "333",
      "layer": "MAIN",
      "exact": "وَأُمُّهُ؛ هِيَ أُمُّ الفَضْلِ لُبَابَةُ بِنْتُ الحَارِثِ بنِ حَزْنِ بنِ بُجَيْرٍ الهِلاَلِيَّةُ"
    },
    {
      "id": "sp_ib26",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "333",
      "layer": "MAIN",
      "exact": "لُبَابَةُ بِنْتُ الحَارِثِ بنِ حَزْنِ",
      "prefix": "هِيَ أُمُّ الفَضْلِ"
    },
    {
      "id": "sp_ib30",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "333",
      "layer": "MAIN",
      "exact": "وَلَهُ جَمَاعَةُ أَوْلاَدٍ؛ أَكْبَرُهُمُ: العَبَّاسُ - وَبهِ كَانَ يُكْنَى - وَعَلِيٌّ أَبُو الخُلَفَاءِ - وَهُوَ أَصْغَرُهُم - وَالفَضْلُ، وَمُحَمَّدٌ، وَعُبَيْدُ اللهِ، وَلُبَابَةُ، وَأَسْمَاءُ."
    },
    {
      "id": "sp_ib32",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "333",
      "layer": "MAIN",
      "exact": "العَبَّاسُ - وَبهِ كَانَ يُكْنَى - وَعَلِيٌّ أَبُو الخُلَفَاءِ",
      "prefix": "أَكْبَرُهُمُ:"
    },
    {
      "id": "sp_ib33",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "333",
      "layer": "MAIN",
      "exact": "وَأَوْلاَدُهُ: الفَضْلُ، وَمُحَمَّدٌ، وَعُبَيْدُ اللهِ، مَاتُوا وَلاَ عَقِبَ لَهُم."
    },
    {
      "id": "sp_ib49",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "333",
      "layer": "MAIN",
      "exact": "وَكَانَ وَسِيماً، جَمِيْلاً، مَدِيدَ القَامَةِ، مَهِيباً"
    },
    {
      "id": "sp_ib52",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "337",
      "layer": "MAIN",
      "exact": "حَمَّادُ بنُ سَلَمَةَ، وَغَيْرُه: عَنْ عَبْدِ اللهِ بنِ عُثْمَانَ بنِ خُثَيْمٍ، عَنْ سَعِيْدِ بنِ جُبَيْرٍ، عَنْ عَبْدِ اللهِ، قَالَ:"
