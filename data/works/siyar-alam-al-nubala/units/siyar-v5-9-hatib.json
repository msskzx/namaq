    {
      "id": "sp_ht_abd_isnad",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "44",
      "layer": "MAIN",
      "exact": "اللَّيْثُ: عَنْ أَبِي الزُّبَيْرِ، عَنْ جَابِرٍ"
    },
    {
      "id": "sp_ht_abd",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "44",
      "layer": "MAIN",
      "exact": "أَنَّ عَبْداً لِحَاطِبٍ شَكَا حَاطِباً، فَقَالَ: يَا نَبِيَّ اللهِ، لَيَدْخُلَنَّ النَّارَ! قَالَ: كَذَبْتَ، لاَ يَدْخُلُهَا أَبَداً وَقَدْ شَهِدَ بَدْراً وَالحُدَيْبِيَةَ"
    },
    {
      "id": "sp_ht_sahih",
