    {
      "id": "sp_ht_hud_b",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "44",
      "layer": "MAIN",
      "exact": "شَهِدَ بَدْراً وَالحُدَيْبِيَةَ",
