    {
      "id": "sp_ht_letter_frame",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "45",
      "layer": "MAIN",
      "exact": "فَقَالَ عُمَرُ: ائْذَنْ لِي يَا رَسُوْلَ اللهِ فِي قَتْلِهِ"
    },
    {
      "id": "sp_ht_letter_isnad",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "44",
      "layer": "MAIN",
      "exact": "إِسْحَاقُ بنُ رَاشِدٍ: عَنِ الزُّهْرِيِّ، عَنْ عُرْوَةَ، عَنْ عَبْدِ الرَّحْمَنِ بنِ حَاطِبٍ"
    },
    {
      "id": "sp_ht_letter",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "45",
      "layer": "MAIN",
      "exact": "لاَ، إِنَّهُ قَدْ شَهِدَ بَدْراً، وَإِنَّكَ لاَ تَدْرِي، لَعَلَّ اللهَ قَدِ اطَّلَعَ عَلَى أَهْلِ بَدْرٍ، فَقَالَ: اعْمَلُوا مَا شِئْتُم، فَإِنِّي غَافِرٌ لَكُم"
    },
    {
      "id": "sp_ht_salih",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "45",
      "layer": "MAIN",
      "exact": "إِسْنَادُهُ صَالِحٌ، وَأَصْلُهُ فِي (الصَّحِيْحَيْنِ (٢)) "
    },
    {
      "id": "sp_ht_letter_who",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 5,
      "page": "45",
      "layer": "MAIN",
      "exact": "فَدَعَا رَسُوْلُ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ- حَاطِباً حَتَّى قُرِئَ عَلَيْهِ الكِتَابُ"
    },
    {
