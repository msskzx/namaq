    },
    {
      "id": "sp_ja19",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "189",
      "layer": "MAIN",
      "exact": "أَبُو عَبْدِ الرَّحْمَنِ",
      "prefix": "أَبُو عَبْدِ اللهِ، وَ",
      "suffix": "الأَنْصَارِيُّ،"
    },
    {
      "id": "sp_ja21",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "189",
      "layer": "MAIN",
      "exact": "مِنْ أَهْلِ بَيْعَةِ الرُّضْوَانِ، وَكَانَ آخِرَ مَنْ شَهِدَ لَيْلَةَ العَقَبَةِ الثَّانِيَةِ مَوْتاً."
    },
    {
      "id": "sp_ja23",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "189",
      "layer": "MAIN",
      "exact": "شَهِدَ لَيْلَةَ العَقَبَةِ الثَّانِيَةِ"
    },
    {
      "id": "sp_ja27",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "189",
      "layer": "MAIN",
      "exact": "وَكَانَ آخِرَ مَنْ شَهِدَ لَيْلَةَ العَقَبَةِ الثَّانِيَةِ مَوْتاً"
    },
    {
      "id": "sp_ja29",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "192",
      "layer": "MAIN",
      "exact": "قَالَ لَنَا رَسُوْلُ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الحُدَيْبِيَةِ"
    },
    {
      "id": "sp_ja33",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "190",
      "layer": "MAIN",
      "exact": "وَكَانَ مُفْتِي المَدِيْنَةِ فِي زَمَانِهِ."
    },
    {
      "id": "sp_ja36",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "190",
      "layer": "MAIN",
      "exact": "وَكَانَ جَابِرٌ قَدْ أَطَاعَ أَبَاهُ يَوْمَ أُحُدٍ، وَقَعَدَ لأَجْلِ أَخَوَاتِهِ، ثُمَّ شَهِدَ الخَنْدَقَ وَبَيْعَةَ الشَّجَرَةِ"
    },
    {
      "id": "sp_ja40",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "190",
      "layer": "MAIN",
