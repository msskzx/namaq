      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "189",
      "layer": "MAIN",
      "exact": "الإِمَامُ الكَبِيْرُ، المُجْتَهِدُ، الحَافِظُ، صَاحِبُ رَسُوْلِ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - أَبُو عَبْدِ اللهِ، وَأَبُو عَبْدِ الرَّحْمَنِ الأَنْصَارِيُّ"
    },
    {
      "id": "sp_ja17",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "189",
      "layer": "MAIN",
      "exact": "أَبُو عَبْدِ اللهِ",
