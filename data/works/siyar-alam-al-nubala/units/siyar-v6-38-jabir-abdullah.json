    {
      "id": "sp_ja51",
      "edition": "siyar-risalah-1405-arnaut",
      "volume": 6,
      "page": "190",
      "layer": "MAIN",
      "exact": "اسْتَغْفَرَ لِي رَسُوْلُ اللهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - لَيْلَةَ البَعِيْرِ خَمْساً وَعِشْرِيْنَ مَرَّةً"
    },
