{"juz":13,"items":[{"surah":13},{"basmala":true},{"line":["الٓمٓرۚ","تِلۡكَ","ءَايَٰتُ","ٱلۡكِتَٰبِۗ","وَٱلَّذِيٓ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَ","ٱلۡحَقُّ"]},{"line":["وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ",1,"ٱللَّهُ","ٱلَّذِي","رَفَعَ","ٱلسَّمَٰوَٰتِ"]},{"line":["بِغَيۡرِ","عَمَدٖ","تَرَوۡنَهَاۖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَۖ"]},{"line":["كُلّٞ","يَجۡرِي","لِأَجَلٖ","مُّسَمّٗىۚ","يُدَبِّرُ","ٱلۡأَمۡرَ","يُفَصِّلُ","ٱلۡأٓيَٰتِ","لَعَلَّكُم"]},{"line":["بِلِقَآءِ","رَبِّكُمۡ","تُوقِنُونَ",2,"وَهُوَ","ٱلَّذِي","مَدَّ","ٱلۡأَرۡضَ","وَجَعَلَ","فِيهَا","رَوَٰسِيَ"]},{"line":["وَأَنۡهَٰرٗاۖ","وَمِن","كُلِّ","ٱلثَّمَرَٰتِ","جَعَلَ","فِيهَا","زَوۡجَيۡنِ","ٱثۡنَيۡنِۖ","يُغۡشِي","ٱلَّيۡلَ"]},{"line":["ٱلنَّهَارَۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَتَفَكَّرُونَ",3,"وَفِي","ٱلۡأَرۡضِ"]},{"line":["قِطَعٞ","مُّتَجَٰوِرَٰتٞ","وَجَنَّٰتٞ","مِّنۡ","أَعۡنَٰبٖ","وَزَرۡعٞ","وَنَخِيلٞ","صِنۡوَانٞ"]},{"line":["وَغَيۡرُ","صِنۡوَانٖ","يُسۡقَىٰ","بِمَآءٖ","وَٰحِدٖ","وَنُفَضِّلُ","بَعۡضَهَا","عَلَىٰ","بَعۡضٖ"]},{"line":["فِي","ٱلۡأُكُلِۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَعۡقِلُونَ",4,"۞","وَإِن","تَعۡجَبۡ"],"quarter":100},{"line":["فَعَجَبٞ","قَوۡلُهُمۡ","أَءِذَا","كُنَّا","تُرَٰبًا","أَءِنَّا","لَفِي","خَلۡقٖ","جَدِيدٍۗ"]},{"line":["أُوْلَٰٓئِكَ","ٱلَّذِينَ","كَفَرُواْ","بِرَبِّهِمۡۖ","وَأُوْلَٰٓئِكَ","ٱلۡأَغۡلَٰلُ","فِيٓ"]},{"line":["أَعۡنَاقِهِمۡۖ","وَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ",5]}]}
