{
  "expo": {
    "name": "Namaq",
    "slug": "namaq",
    "scheme": "namaq",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.namaq"
    },
    "android": {
      "package": "app.namaq",
      "adaptiveIcon": {
        "backgroundColor": "#f8f6f0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستعمل نمق موقعك لحساب مواقيت الصلاة واتجاه القبلة على جهازك فقط."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "66b966c4-8d30-422d-985d-8be1e196c9c6"
      }
    },
    "owner": "brilliant-star",
    "updates": {
      "url": "https://u.expo.dev/66b966c4-8d30-422d-985d-8be1e196c9c6"
    }
  }
}
